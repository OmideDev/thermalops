# Python virtual environments
.venv/
venv/

# Python cache files
__pycache__/
*.py[cod]

# Environment variables and secrets
.env
.env.*
!.env.example

# Test and type-checker caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Editor and operating system files
.vscode/
.DS_Store
Thumbs.db

# Frontend is maintained in OmideDev/thermalops-front
/frontend/

# RAG manuals and generated extraction artifacts (keep local / licensed copies out of git)
backend/data/manuals/*.pdf
backend/data/manuals/*.json
backend/data/manuals/**/*
!backend/data/manuals/.gitkeep

# Local answer-eval raw runs (answers, timings, Ollama metrics). Reproduce via:
#   set RUN_RAG_ANSWER_EVAL=1
#   python scripts/run_answer_eval.py
# Commit-safe methodology/audit lives under backend/docs/.
backend/app/rag_eval/reports/*
!backend/app/rag_eval/reports/README.md
