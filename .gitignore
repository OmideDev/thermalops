# Python virtual environments
.venv/
venv/

# Python cache files
__pycache__/
*.py[cod]

# Environment variables and secrets
.env
.env.*
!.env.example

# Test and type-checker caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Editor and operating system files
.vscode/
.DS_Store
Thumbs.db

# Frontend
frontend/node_modules/
frontend/dist/
frontend/.env
frontend/.env.*
!frontend/.env.example

# RAG manuals and generated extraction artifacts (keep local / licensed copies out of git)
backend/data/manuals/*.pdf
backend/data/manuals/*.json
backend/data/manuals/**/*
!backend/data/manuals/.gitkeep
